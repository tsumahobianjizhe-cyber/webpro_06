<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <title>じゃんけん2</title>
</head>
<body>
    <p>あなたの手は<%= your %>です．</p>
    <p>コンピュータは<%= cpu %>です．</p>
    <p>判定：<%= judgement %></p>
    <p>現在<%= total %>試合中<%= win %>勝しています．</p>
    <hr>
    <form action="/janken2">
        <input type="radio" name="hand" value="1" id="gu" required>
        <label for="gu">グー</label>
        <input type="radio" name="hand" value="2" id="choki" required>
        <label for="choki">チョキ</label>
        <input type="radio" name="hand" value="3" id="pa" required>
        <label for="pa">パー</label>
        <input type="hidden" name="win" value="<%= win %>">
        <input type="hidden" name="total" value="<%= total %>">
        <input type="submit" value="じゃんけん　ポン">
    </form>   
</body>
</html>