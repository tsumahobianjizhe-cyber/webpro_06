<!Doctype html>
<html>
<head>
  <meta charset="utf-8">
  <title>京葉線の駅</title>
</head>
<body>
  <h2>京葉線の駅の詳細</h2>
  <table>
      <% for( let row of data ) { %>
        <tr>
          <td>ID: <%= row.id %></td>
          <td>駅コード: <%= row.code %></td>
          <td>駅名: <%= row.name %></td>
        </tr>
      <% } %>
  </table>
</body>
</html>